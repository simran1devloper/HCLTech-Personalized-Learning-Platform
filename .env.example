# ═══════════════════════════════════════════════════════
# .env — Personalized Learning AI Environment Configuration
# Copy this file and fill in your real values.
# NEVER commit the real .env to version control.
# ═══════════════════════════════════════════════════════

# ── Server ──
PORT=8000
ENVIRONMENT=development

# ── Security ──
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# ── Supabase ──
# Get from: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# ── Google Gemini ──
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite

# ── CORS (add your frontend origins) ──
# ALLOWED_ORIGINS=["http://localhost:5500","https://your-production-domain.com"]

# ── Database (local) ──
DB_BACKEND=sqlite                 # sqlite (default) | supabase (legacy)
DATABASE_PATH=data/app.db         # relative to backend/

# ── LLM providers (priority order; later ones are failover) ──
LLM_PROVIDERS=openrouter,ollama,gemini   # first usable one answers; the rest are failover. "openrouter" is skipped until OPENROUTER_API_KEY is set
# Ollama Cloud (cloud) -- or http://localhost:11434 with no key for a local server
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=your-ollama-cloud-key
OLLAMA_MODEL=gpt-oss:20b          # pick a model your plan can run: GET {OLLAMA_BASE_URL}/api/tags
# LLM_LOCAL_ONLY=true             # privacy: never use cloud providers (Ollama Cloud counts as cloud)
# LLM_TIMEOUT_S=180
# OLLAMA_DISABLE_THINKING=true     # send think:false so reasoning models (magistral, qwen3, deepseek-r1) answer directly
# Study-material generation streams each section and judges health by silence, not total time:
# CONTENT_STREAMING=true            # false = legacy single blocking request per section
# LLM_FIRST_TOKEN_S=120             # max wait for the first token (model load / queueing); then fails over to the next provider
# LLM_IDLE_TOKEN_S=30               # max silence between tokens
# LLM_STREAM_TOTAL_S=600            # hard cap per section
# CONTENT_NATIVE_SCHEMA=true       # send each JSON section's schema to Ollama/Gemini for constrained decoding (auto-falls back)
# CONTENT_FEWSHOT=true             # worked examples in the key-concepts / flashcards / recommendations / interview prompts
# CONTENT_MERMAID=true             # ask for one validated Mermaid diagram in deep dive, practical guide and roadmap
# CONTENT_SECTION_CONCURRENCY=1     # sections at once on a self-hosted Ollama. Keep 1 unless the server runs OLLAMA_NUM_PARALLEL>1 (a GPU box)
# CONTENT_TIME_BUDGET_S=600         # target time per guide: the pipeline measures real tokens/s, shortens long sections, defers optional ones (0 = off)
# OLLAMA_NUM_CTX=4096               # prompts are <700 tokens, outputs <=1800; a bigger window only wastes RAM
# CONTENT_SECTION_CONCURRENCY_CLOUD=10 # sections at once when the first provider is a cloud API (10 = a whole guide)
# CONTENT_GLOBAL_CONCURRENCY=20        # generation calls in flight across all learners (guides + quiz questions); 0 = no cap. Lower it if the provider rate limits often
# QUESTION_PARALLEL_BATCHES=4          # simultaneous calls that write new quiz questions on a hosted provider (1 = one call; local Ollama is always sequential)
# ── OpenRouter (hosted models, one key): https://openrouter.ai/keys ──
OPENROUTER_API_KEY=                # paste your key here (never commit it)
OPENROUTER_MODEL=openai/gpt-4o-mini   # any model id from https://openrouter.ai/models
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_REFERER=http://localhost:8000
# OPENROUTER_TITLE=LearnAI
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# REDIS_URL=redis://localhost:6379/0
# RATE_LIMIT_PER_MINUTE=60
# ALLOW_UNSIGNED_QUIZ=false       # once all clients send quiz_token

# ── AI Tutor ──
# Simplest hosted setup: set OPENROUTER_API_KEY above and LLM_PROVIDERS=openrouter (verify: cd backend && python scripts/check_openrouter.py).
# Questions and the relevant learner data are then sent to that provider; LLM_LOCAL_ONLY=true forbids it.
# TUTOR_CONTEXT_WINDOW_TOKENS=0      # 0 = automatic (OLLAMA_NUM_CTX while "ollama" is listed, otherwise 16000)
# TUTOR_MAX_OUTPUT_TOKENS=1600
# TUTOR_FIRST_TOKEN_S=180            # max wait for the first token (CPU-only local models are slow)
# TUTOR_IDLE_TOKEN_S=60              # max silence between tokens
# TUTOR_ROUTING=configured           # configured (LLM_PROVIDERS order) | balanced (order by task complexity)
# TUTOR_COST_INPUT_PER_MTOK=0        # USD per million tokens, for the cost estimate in GET /api/v1/tutor/usage (0 = not shown)
# TUTOR_COST_OUTPUT_PER_MTOK=0

# ── Agentic content platform rollout flags (defaults keep current behaviour) ──
# CONTENT_PIPELINE=legacy          # legacy | v2
# GENERATION_BACKEND=inline        # inline | queue
# CACHE_BACKEND=memory             # memory | redis
# STORE_BACKEND=sqlite             # sqlite | postgres
# ATOM_REUSE=off                   # off | on
# AGENT_PIPELINE=off               # off | on
# REVIEW_GATES=off                 # off | on
# Local dev infrastructure: docker compose -f docker-compose.dev.yml up -d
# DATABASE_URL=postgresql+psycopg://learnai:learnai_dev_only@127.0.0.1:5433/learnai
# REDIS_URL=redis://127.0.0.1:6380/0
